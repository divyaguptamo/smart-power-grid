# Copy this file to .env.local and fill in your own values.
# Never commit .env.local - it is listed in .gitignore.

# MySQL (relational, transactional master data)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=grid_app
# Wrap values in double quotes if they contain # or spaces
MYSQL_PASSWORD="change-me"
MYSQL_DATABASE=smart_power_grid

# MongoDB (meter telemetry + grid events)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=smart_grid_telemetry

# Secret used to sign login sessions (any long random string, 32+ characters)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
